@model IEnumerable<ManagementAsset.Models.Asset>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ManagementAsset.Models.ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Daftar Aset";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold">Daftar Aset</h2>
        <small class="text-muted">Total: @Model.Count() aset ditemukan</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary px-4" asp-action="Create">
            + Tambah Aset
        </a>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small mb-1">Cari Aset</label>
                    <input type="text" name="search" value="@(ViewBag.Search ?? "")" class="form-control" placeholder="Nama atau kode aset..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small mb-1">Status</label>
                    <select name="status" class="form-select">
                        <option value="">Semua Status</option>
                        @foreach (var s in new[] { "Tersedia", "Digunakan", "Perbaikan", "Rusak" })
                        {
                            if (ViewBag.Status == s)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small mb-1">Kategori</label>
                    <select name="categoryId" class="form-select">
                        <option value="">Semua Kategori</option>
                        @foreach (var cat in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Categories)
                        {
                            if (ViewBag.CategoryId?.ToString() == cat.Value)
                            {
                                <option value="@cat.Value" selected>@cat.Text</option>
                            }
                            else
                            {
                                <option value="@cat.Value">@cat.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Kode</th>
                        <th>Nama Aset</th>
                        <th>Kategori</th>
                        <th>Lokasi</th>
                        <th>Status</th>
                        <th>Harga Beli</th>
                        <th class="text-center pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="fw-semibold text-muted small">@item.AssetCode</span>
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category?.Name</span>
                            </td>
                            <td class="text-muted">@item.Location?.Name</td>
                            <td>
                                <span class="badge @GetStatusBadge(item.Status) px-2 py-1">
                                    @item.Status
                                </span>
                            </td>
                            <td class="fw-semibold">Rp @item.PurchasePrice.ToString("N0")</td>
                            <td class="text-center pe-3">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detail</a>
                                    @if (!User.IsInRole("Admin") && item.Status == ManagementAsset.Models.AssetStatus.Tersedia)
                                    {
                                        <a asp-controller="Peminjaman" asp-action="Ajukan" asp-route-id="@item.Id"
                                            class="btn btn-sm btn-success">Pinjam</a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Hapus</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-2" style="font-size:2rem;">&#128269;</div>
                                <div>Tidak ada aset ditemukan.</div>
                                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string) || ViewBag.CategoryId != null)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">Hapus Filter</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadge(ManagementAsset.Models.AssetStatus status) => status switch
    {
        ManagementAsset.Models.AssetStatus.Tersedia => "bg-success",
        ManagementAsset.Models.AssetStatus.Digunakan => "bg-primary",
        ManagementAsset.Models.AssetStatus.Perbaikan => "bg-warning text-dark",
        ManagementAsset.Models.AssetStatus.Rusak => "bg-danger",
        _ => "bg-secondary"
    };
}
