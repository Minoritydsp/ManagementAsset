@model ManagementAsset.Models.Asset

@{
    ViewData["Title"] = "Edit Aset";
}

<h2>Edit Aset</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="mb-3">
                <label asp-for="AssetCode" class="form-label">Kode Aset</label>
                <input asp-for="AssetCode" class="form-control" />
                <span asp-validation-for="AssetCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nama Aset</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Deskripsi</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Kategori</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Pilih Kategori --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LocationId" class="form-label">Lokasi</label>
                <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                    <option value="">-- Pilih Lokasi --</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ManagementAsset.Models.AssetStatus>()"
                    class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="PurchasePrice" class="form-label">Harga Beli (Rp)</label>
                <input asp-for="PurchasePrice" class="form-control" type="number" />
                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PurchaseDate" class="form-label">Tanggal Beli</label>
                <input asp-for="PurchaseDate" class="form-control" type="date" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Simpan Perubahan</button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
