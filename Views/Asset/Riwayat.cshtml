@model IEnumerable<ManagementAsset.Models.RiwayatAset>

@{
    ViewData["Title"] = "Riwayat Aset";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold">Riwayat Aset</h2>
        <small class="text-muted">@ViewBag.AssetCode — @ViewBag.AssetName</small>
    </div>
    <a asp-action="Details" asp-route-id="@ViewBag.AssetId" class="btn btn-outline-secondary">
        &larr; Kembali
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Tanggal</th>
                        <th>Aksi</th>
                        <th>Oleh</th>
                        <th>Status</th>
                        <th class="pe-3">Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 text-muted small">@item.TanggalAksi.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="fw-semibold">@item.Aksi</td>
                            <td>@(item.User?.FullName ?? item.User?.Email ?? "-")</td>
                            <td>
                                @if (item.StatusLama.HasValue)
                                {
                                    <span class="badge bg-secondary">@item.StatusLama</span>
                                    <span class="text-muted">→</span>
                                }
                                @if (item.StatusBaru.HasValue)
                                {
                                    <span class="badge @GetStatusBadge(item.StatusBaru.Value)">@item.StatusBaru</span>
                                }
                            </td>
                            <td class="text-muted pe-3">@(item.Keterangan ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Belum ada riwayat untuk aset ini.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadge(ManagementAsset.Models.AssetStatus status) => status switch
    {
        ManagementAsset.Models.AssetStatus.Tersedia => "bg-success",
        ManagementAsset.Models.AssetStatus.Digunakan => "bg-primary",
        ManagementAsset.Models.AssetStatus.Perbaikan => "bg-warning text-dark",
        ManagementAsset.Models.AssetStatus.Rusak => "bg-danger",
        _ => "bg-secondary"
    };
}
