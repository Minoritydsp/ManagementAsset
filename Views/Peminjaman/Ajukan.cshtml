@model ManagementAsset.Models.Peminjaman

@{
    ViewData["Title"] = "Ajukan Peminjaman";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-bold">Ajukan Peminjaman</h5>
            </div>
            <div class="card-body">

                <div class="mb-3 p-3 bg-light rounded">
                    <div class="text-muted small mb-1">Aset yang dipinjam</div>
                    <div class="fw-bold">@Model.Asset?.Name</div>
                    <div class="text-muted small">@Model.Asset?.AssetCode</div>
                </div>

                <form asp-action="Ajukan" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AssetId" />

                    <div class="mb-3">
                        <label asp-for="Keperluan" class="form-label fw-semibold">Keperluan</label>
                        <textarea asp-for="Keperluan" class="form-control" rows="4"
                            placeholder="Jelaskan keperluan peminjaman aset ini..."></textarea>
                        <span asp-validation-for="Keperluan" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Kirim Pengajuan</button>
                        <a asp-controller="Asset" asp-action="Index" class="btn btn-outline-secondary w-100">Batal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
