@model ManagementAsset.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<!-- Kartu Statistik -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6 class="card-title">Total Aset</h6>
                <h2 class="card-text">@Model.TotalAset</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6 class="card-title">Tersedia</h6>
                <h2 class="card-text">@Model.TotalTersedia</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h6 class="card-title">Digunakan</h6>
                <h2 class="card-text">@Model.TotalDigunakan</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h6 class="card-title">Rusak</h6>
                <h2 class="card-text">@Model.TotalRusak</h2>
            </div>
        </div>
    </div>
</div>

<!-- Tabel Ringkasan -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header fw-bold">Aset per Kategori</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kategori</th>
                            <th>Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AsetPerKategori)
                        {
                            <tr>
                                <td>@item.Key</td>
                                <td><span class="badge bg-primary">@item.Value</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header fw-bold">Aset per Lokasi</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Lokasi</th>
                            <th>Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AsetPerLokasi)
                        {
                            <tr>
                                <td>@item.Key</td>
                                <td><span class="badge bg-success">@item.Value</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Aset Terbaru -->
<div class="card">
    <div class="card-header fw-bold">5 Aset Terbaru Ditambahkan</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>Kode</th>
                    <th>Nama</th>
                    <th>Kategori</th>
                    <th>Status</th>
                    <th>Tanggal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.AsetTerbaru)
                {
                    <tr>
                        <td>@item.AssetCode</td>
                        <td>@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Status</td>
                        <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
